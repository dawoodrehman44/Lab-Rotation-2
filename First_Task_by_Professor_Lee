    checkpoint_losses = checkpoint["checkpoint_losses"]

# Training Loop
save_every = 1  # Save checkpoint every N epochs

for epoch in range(resume_epoch, epochs):
    diffusion_model.train()
    running_loss = 0.0
    start_time = time.time()

    for images, labels in train_loader:
        # Original Training Logic
        images = images.to(device)
        labels = labels.to(device)
        demographic_data = labels[:, :2]  # Assuming first two labels are age and gender

        noise = torch.randn_like(images).to(device)
        timesteps = torch.randint(0, diffusion_scheduler.num_train_timesteps, (images.size(0),), device=device).long()

        noisy_images = diffusion_scheduler.add_noise(images, noise, timesteps)

        optimizer.zero_grad()
        outputs = diffusion_model(noisy_images, demographic_data, labels)
        loss = criterion(outputs, noise)
        loss.backward()
        optimizer.step()

        running_loss += loss.item()

    epoch_time = time.time() - start_time
    epoch_loss = running_loss / len(train_loader)
    training_losses.append(epoch_loss)
