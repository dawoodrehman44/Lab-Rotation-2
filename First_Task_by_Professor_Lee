# Define the Diffusion Model with Demographic Conditioning
class DiffusionUNetModel(nn.Module):
    def __init__(self, num_channels=3, image_size=256, demographic_dim=2, label_dim=14):
        super(DiffusionUNetModel, self).__init__()
        self.unet = UNet2DModel(
            sample_size=image_size,  # Image size
            in_channels=num_channels,  # Number of input channels
            out_channels=num_channels,  # Number of output channels
            layers_per_block=2,
            block_out_channels=(64, 128, 256, 512),
            down_block_types=(
                "DownBlock2D", "DownBlock2D", "DownBlock2D", "AttnDownBlock2D"
            ),
            up_block_types=(
                "AttnUpBlock2D", "UpBlock2D", "UpBlock2D", "UpBlock2D"
            ),
        )
        self.demographic_fc = nn.Linear(demographic_dim, 128)
        self.label_fc = nn.Linear(label_dim, 128)
        self.combine_fc = nn.Linear(256, 128)

    def forward(self, x, demographic_data, labels):
        demo_features = self.demographic_fc(demographic_data)
        label_features = self.label_fc(labels)
        combined_features = torch.cat((demo_features, label_features), dim=-1)
        combined_features = self.combine_fc(combined_features)
        combined_features = combined_features.view(-1, 128, 1, 1)
        combined_features = combined_features.expand(-1, 128, x.size(2), x.size(3))
        x = torch.cat((x, combined_features), dim=1)
        return self.unet(x).sample

